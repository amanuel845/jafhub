{
  "version": 2,
  "functions": {
    "api/github.js":  { "maxDuration": 60, "memory": 512 },
    "api/graphql.js": { "maxDuration": 60, "memory": 512 },
    "api/meta.js":    { "maxDuration": 30, "memory": 256 }
  },
  "rewrites": [
    { "source": "/api/github/:path*", "destination": "/api/github?githubPath=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "no-referrer" },
        { "key": "X-Frame-Options",        "value": "DENY" }
      ]
    }
  ]
}
