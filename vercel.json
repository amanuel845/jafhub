{
  "version": 2,
  "functions": {
    "api/github/[...path].js": { "maxDuration": 60, "memory": 512 },
    "api/graphql.js":          { "maxDuration": 60, "memory": 512 },
    "api/meta.js":             { "maxDuration": 15, "memory": 256 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "no-referrer" },
        { "key": "X-Frame-Options",        "value": "DENY" }
      ]
    }
  ]
}
